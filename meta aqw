<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gerenciador de Tarefas Colaborativo</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-6 font-sans">

  <div class="max-w-2xl mx-auto bg-white rounded-xl shadow-md p-6">
    <h1 class="text-2xl font-bold text-gray-800 mb-6">📋 Tarefas Compartilhadas</h1>

    <!-- Form para Adicionar Tarefa Mãe -->
    <div class="flex gap-2 mb-6">
      <input type="text" id="parentInput" placeholder="Nova tarefa principal..." class="flex-1 border rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
      <button onclick="addParentTask()" class="bg-blue-600 text-white px-4 py-2 rounded-lg font-medium hover:bg-blue-700">Adicionar</button>
    </div>

    <!-- Lista de Tarefas -->
    <div id="tasksList" class="space-y-4"></div>
  </div>

  <script>
    // Estrutura de dados local para teste
    let tasks = [];

    function renderTasks() {
      const container = document.getElementById('tasksList');
      container.innerHTML = '';

      tasks.forEach((task, pIndex) => {
        // Cálculo de Porcentagem
        const totalSub = task.subtasks.length;
        const completedSub = task.subtasks.filter(s => s.completed).length;
        const progress = totalSub > 0 ? Math.round((completedSub / totalSub) * 100) : 0;

        const card = document.createElement('div');
        card.className = "border rounded-lg p-4 bg-gray-50";
        card.innerHTML = `
          <div class="flex justify-between items-center mb-2">
            <h3 class="font-semibold text-lg text-gray-700">${task.title}</h3>
            <span class="text-sm font-bold text-gray-500">${progress}%</span>
          </div>

          <!-- Barra de Progresso -->
          <div class="w-full bg-gray-200 rounded-full h-2.5 mb-4">
            <div class="bg-green-500 h-2.5 rounded-full transition-all duration-300" style="width: ${progress}%"></div>
          </div>

          <!-- Subtarefas -->
          <div class="pl-4 space-y-2 mb-3">
            ${task.subtasks.map((sub, sIndex) => `
              <label class="flex items-center gap-2 text-sm cursor-pointer">
                <input type="checkbox" ${sub.completed ? 'checked' : ''} onchange="toggleSubtask(${pIndex}, ${sIndex})" class="rounded text-blue-600 focus:ring-blue-500">
                <span class="${sub.completed ? 'line-through text-gray-400' : 'text-gray-700'}">${sub.title}</span>
              </label>
            `).join('')}
          </div>

          <!-- Input para Subtarefa -->
          <div class="flex gap-2">
            <input type="text" id="subInput-${pIndex}" placeholder="Adicionar subtarefa..." class="text-sm border rounded px-3 py-1 flex-1">
            <button onclick="addSubtask(${pIndex})" class="bg-gray-200 text-gray-700 text-sm px-3 py-1 rounded hover:bg-gray-300">+ Subtarefa</button>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function addParentTask() {
      const input = document.getElementById('parentInput');
      if (!input.value.trim()) return;
      tasks.push({ title: input.value, subtasks: [] });
      input.value = '';
      renderTasks();
    }

    function addSubtask(parentIndex) {
      const input = document.getElementById(`subInput-${parentIndex}`);
      if (!input.value.trim()) return;
      tasks[parentIndex].subtasks.push({ title: input.value, completed: false });
      input.value = '';
      renderTasks();
    }

    function toggleSubtask(parentIndex, subIndex) {
      tasks[parentIndex].subtasks[subIndex].completed = !tasks[parentIndex].subtasks[subIndex].completed;
      renderTasks();
    }
  </script>
</body>
</html>
